{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astro-static/00-pipeline-state.schema.json",
  "title": "Astro Static Pipeline State",
  "type": "object",
  "required": [
    "project_name",
    "started_at",
    "updated_at",
    "needs_human_review",
    "phases"
  ],
  "properties": {
    "project_name": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "needs_human_review": {
      "type": "boolean"
    },
    "review_file": {
      "type": [
        "string",
        "null"
      ]
    },
    "phases": {
      "type": "object",
      "required": [
        "0_bootstrap_launch",
        "1_design_extraction",
        "2_research",
        "2_5_brief_validation",
        "3_asset_generation",
        "3_5_image_generation",
        "3_6_video_generation",
        "3_8_hyperframes_hero_optional",
        "4_1_frontend_codegen",
        "4_2_tinacms_local_build",
        "4_3_build_deploy",
        "5_publish_result"
      ],
      "properties": {
        "0_bootstrap_launch": {
          "$ref": "#/$defs/phaseWithLaunch"
        },
        "1_design_extraction": {
          "$ref": "#/$defs/phase"
        },
        "2_research": {
          "$ref": "#/$defs/phase"
        },
        "2_5_brief_validation": {
          "$ref": "#/$defs/phase"
        },
        "3_asset_generation": {
          "$ref": "#/$defs/phase"
        },
        "3_5_image_generation": {
          "$ref": "#/$defs/phase"
        },
        "3_6_video_generation": {
          "$ref": "#/$defs/phase"
        },
        "3_8_hyperframes_hero_optional": {
          "$ref": "#/$defs/phase"
        },
        "4_1_frontend_codegen": {
          "$ref": "#/$defs/phase"
        },
        "4_2_tinacms_local_build": {
          "$ref": "#/$defs/phase"
        },
        "4_3_build_deploy": {
          "$ref": "#/$defs/phase"
        },
        "5_publish_result": {
          "$ref": "#/$defs/phase"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "phaseStatus": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "launched",
        "completed",
        "skipped",
        "stale",
        "invalidated",
        "failed",
        "halted_for_review"
      ]
    },
    "phase": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/phaseStatus"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "invalidated_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "invalidated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "rerun_from": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "phaseWithLaunch": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/phaseStatus"
        },
        "launched_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "pid_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "log_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "exit_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "invalidated_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "invalidated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "rerun_from": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
